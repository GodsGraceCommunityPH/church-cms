{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:navigation": "node --test tests/navigation/*.test.mjs",
    "test:fundraising": "node --experimental-strip-types --test tests/fundraising/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:project-ilaw": "node --experimental-strip-types --test tests/fundraising/*.test.mjs && node --test tests/security/project-ilaw-order-contract.test.mjs",
    "test:dashboard": "node --experimental-strip-types --test tests/dashboard/*.test.mjs",
    "test:member-duplicates": "node --experimental-strip-types --test tests/members/*.test.mjs",
    "test:users": "node --experimental-strip-types --test tests/users/*.test.mjs",
    "test:activation": "node --experimental-strip-types --test tests/users/account-activation.test.mjs tests/users/account-reconciliation.test.mjs",
    "test:concurrency": "node --test tests/users/account-activation-concurrency.test.mjs",
    "preview": "vite preview",
    "push": "cd .. && npm run push"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.2",
    "lucide-react": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pg": "^8.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
