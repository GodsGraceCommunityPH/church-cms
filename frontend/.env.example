# Copy to .env.local (or .env) and fill in the project values.
# Never commit real keys.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Project Ilaw manual payment contact.
# Bryan Castro's real Facebook Messenger link, for example:
#   VITE_PROJECT_ILAW_MESSENGER_URL=https://m.me/<bryan-username>
# Only https links on m.me, messenger.com, facebook.com, or www.facebook.com are
# accepted. When this is empty or invalid, the order confirmation keeps the
# payment instructions but renders a disabled Messenger button instead of
# inventing a link.
VITE_PROJECT_ILAW_MESSENGER_URL=
